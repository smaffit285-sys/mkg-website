---
import "../styles/global.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/neon.css";
import "../styles/hero.css";
import "../styles/service-cards.css";
import "../styles/panels.css";
import "../styles/proof.css";
import "../styles/our-story.css";
import interactionsScript from "../scripts/interactions.js?url";
import analyticsScript from "../scripts/analytics.js?url";
import { GOOGLE_REVIEW_COUNT } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  pageClass?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  preloadHero?: boolean;
  robots?: string;
}

const {
  title = "Miami Knife Guy | Premium Knife Sharpening in South Florida",
  description = "Premium knife sharpening in South Florida for chefs, restaurants, hotels, and serious home kitchens. Based in North Miami Beach and serving select clients from Miami to Fort Lauderdale.",
  canonicalPath = "/",
  image = "/images/brand/mkg-logo.jpg",
  pageClass = "",
  schema = [],
  preloadHero = false,
  robots = "index, follow",
} = Astro.props;

const siteUrl = "https://www.miamiknifeguy.com";
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const socialImage = new URL(image, siteUrl).toString();
const schemas = Array.isArray(schema) ? schema : [schema];
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${siteUrl}/#business`,
  name: "Miami Knife Guy",
  alternateName: "MKG",
  description: "Premium knife sharpening and edge care in South Florida for chefs, restaurants, hotels, hospitality teams, and serious home kitchens.",
  url: `${siteUrl}/`,
  telephone: "+13059095773",
  priceRange: "$$",
  image: `${siteUrl}/images/brand/mkg-logo.jpg`,
  aggregateRating: { "@type": "AggregateRating", ratingValue: "5.0", reviewCount: String(GOOGLE_REVIEW_COUNT) },
  address: {
    "@type": "PostalAddress",
    addressLocality: "North Miami Beach",
    addressRegion: "FL",
    addressCountry: "US",
  },
  areaServed: ["North Miami Beach", "Aventura", "Sunny Isles Beach", "Hollywood", "Fort Lauderdale", "Miami", "South Florida"],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="theme-color" content="#060609" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Miami Knife Guy" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={socialImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link href="https://fonts.googleapis.com/css2?family=Dosis:wght@300;400;500&family=Montserrat:wght@300;400;500;600;700;800&family=Yellowtail&family=Playfair+Display:ital,wght@1,900&family=Alex+Brush&display=swap" rel="stylesheet" />
{preloadHero && <link rel="preload" href="/images/backgrounds/miami-skyline.webp" as="image" type="image/webp" fetchpriority="high" />}
<!-- Privacy-friendly analytics by Plausible -->
<script async src="https://plausible.io/js/pa-LvFj7u-EnfNshXjuf74lQ.js"></script>
<script is:inline>
  window.plausible = window.plausible || function () {
    (plausible.q = plausible.q || []).push(arguments);
  };
  plausible.init = plausible.init || function (options) {
    plausible.o = options || {};
  };
  plausible.init({
    outboundLinks: false,
    fileDownloads: false,
    transformRequest(payload) {
      if (!payload || !payload.u) return payload;
      try {
        const url = new URL(payload.u);
        if (/^\/r\/[^/]+\/?$/.test(url.pathname)) url.pathname = "/r/referral/";
        const allowedCampaignParams = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"];
        const campaignParams = new URLSearchParams();
        allowedCampaignParams.forEach((key) => {
          const value = url.searchParams.get(key);
          if (value) campaignParams.set(key, value);
        });
        url.search = campaignParams.toString();
        url.hash = "";
        payload.u = url.toString();
      } catch {
        return payload;
      }
      return payload;
    },
  });
</script>
<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)}></script>
{schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)}></script>)}
</head>
<body class:list={["min-h-screen bg-[#060609] text-white", pageClass, { "overflow-hidden": !pageClass.includes("route-page") }]}>
<slot />
<script src={interactionsScript}></script>
<script src={analyticsScript}></script>
</body>
</html>
