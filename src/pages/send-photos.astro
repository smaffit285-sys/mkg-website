---
import RouteShell from "../components/RouteShell.astro";
import CustomerFlowPage from "../components/CustomerFlowPage.astro";
import RequestForm from "../components/RequestForm.astro";
import { sharpeningServices } from "../config/sharpeningServices";
export const prerender = true;
---
<RouteShell
  title="Knife & Tool Sharpening Requests | Miami Knife Guy"
  description="Send photos of knives, shears, blades, and specialty tools for sharpening, repair, thinning, or custom work assessment by Miami Knife Guy."
  canonicalPath="/send-photos/"
  pageClass="intake-page"
>
  <CustomerFlowPage
    intake={true}
    eyebrow="Sharpening · Repair · Custom Work"
    headline="Show us what needs an edge."
    intro="Knives, shears, blades, or specialty tools: choose a service and tell Sean what you need. Clear photos help him assess the work and confirm the approach, price, and timing."
    steps={[
      { title: "Full profile", copy: "Photograph the entire knife from the side on a plain, well-lit background." },
      { title: "Damage close-up", copy: "Include the chip, broken tip, bend, corrosion, or worn section from multiple angles." },
      { title: "Both blade faces", copy: "Send both sides and note the maker, steel, intended use, and anything finish-sensitive." },
    ]}
    primaryHref="tel:+13059095773"
    primaryLabel="Call MKG"
    secondaryHref="/knife-repair-restoration-miami/"
    secondaryLabel="Repair Services"
    nextCopy="Prepare the photo request, then share or text the message. Photos stay on your device until you choose to send them."
  >
    <RequestForm
      id="special-request-review"
      title="Request Knife & Tool Service"
      description="Choose the main service below and add any other tools in your notes. Specialty work and custom requests are assessed before scheduling."
      source="public_send_photos"
      serviceType="photo_review"
      submitLabel="Review My Photo Request"
      photoHandoff={true}
      fields={[
        { name: "name", label: "Your name", required: true, placeholder: "Name" },
        { name: "phone", label: "Phone", type: "tel", required: true, placeholder: "(305) 555-0123" },
        { name: "email", label: "Email", type: "email", placeholder: "you@example.com" },
        { name: "requestType", label: "Sharpening service or tool", type: "select", required: true, options: sharpeningServices },
        { name: "notes", label: "Knife or tool details", type: "textarea", required: true, fullWidth: true, placeholder: "Describe the knife or tool, quantity, condition, maker, intended use, timing, and what you would like reviewed" },
        { name: "photos", label: "Knife or tool photos", type: "file", fullWidth: true, accept: "image/*", multiple: true, help: "Show the whole tool, both sides of the blade, and any damage. Photos stay on your device. On supported phones, the share sheet can pass them to Messages. Otherwise, attach them after the prepared message opens." },
      ]}
    />
    <p class="sub-body intake-next">Thinning starts at <strong>$16 per side of the knife</strong>. Charges increase with the amount of material removed, labor and abrasives expended, and total time spent on the work.</p>
  </CustomerFlowPage>
</RouteShell>
