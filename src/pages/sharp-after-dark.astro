---
import RouteShell from "../components/RouteShell.astro";
import SharpAfterDarkPanel from "../components/SharpAfterDarkPanel.astro";
export const prerender = true;
const faq = [
  { question: "What is Sharp After Dark?", answer: "Sharp After Dark is MKG’s recurring after-hours edge-care program for restaurants, hotels, and commercial kitchens." },
  { question: "Who is Sharp After Dark for?", answer: "It is built for hospitality teams that need sharp, accountable knife fleets without interrupting prep or service." },
  { question: "How does after-hours knife service work?", answer: "Knives are collected after service, sharpened and repaired as needed, then returned before the agreed prep window. Scheduling is reviewed before the program is confirmed." },
  { question: "Can you handle weekly or bi-weekly restaurant programs?", answer: "Yes. Weekly, bi-weekly, and other recurring schedules can be arranged around fleet size, volume, and kitchen operations." },
  { question: "Do you service steak knives and guest-facing knives?", answer: "Yes. Straight-edge and serviceable serrated steak knives can be included in a restaurant or hotel program." },
  { question: "How do I request a Sharp After Dark program?", answer: "Use the Restaurant Service booking page and share your location, approximate knife count, preferred schedule, and any repair or dining-room needs." },
];
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Sharp After Dark Restaurant Knife Sharpening",
  provider: { "@id": "https://www.miamiknifeguy.com/#business" },
  areaServed: "South Florida",
  serviceType: "After-hours restaurant and commercial kitchen knife sharpening",
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---
<RouteShell
  title="Sharp After Dark | Restaurant Knife Sharpening Miami"
  description="Zero-downtime recurring knife sharpening for Miami restaurants, hotels, and commercial kitchens, with after-hours collection and return."
  canonicalPath="/sharp-after-dark/"
  image="/images/brand/sharp-after-dark-transparent.webp"
  schema={[serviceSchema, faqSchema]}
>
  <SharpAfterDarkPanel faq={faq} />
</RouteShell>
