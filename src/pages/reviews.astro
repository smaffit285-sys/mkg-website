---
import RouteShell from "../components/RouteShell.astro";
import ReviewsPanel from "../components/ReviewsPanel.astro";
import { GOOGLE_REVIEW_COUNT } from "../config/site";
import { googleReviews } from "../data/googleReviews";
export const prerender = true;
const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Miami Knife Guy Google Reviews",
  numberOfItems: GOOGLE_REVIEW_COUNT,
  itemListElement: googleReviews.map(({ name, body, rating }, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Review",
      author: { "@type": "Person", name },
      reviewBody: body,
      reviewRating: { "@type": "Rating", ratingValue: rating },
    },
  })),
};
---
<RouteShell
  title="Miami Knife Guy Reviews | Verified Google Reviews"
  description="Read all 18 verified five-star Google reviews for Miami Knife Guy knife sharpening and repair services."
  canonicalPath="/reviews/"
  schema={schema}
>
  <ReviewsPanel />
</RouteShell>
