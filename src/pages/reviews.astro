---
import RouteShell from "../components/RouteShell.astro";
import ReviewsPanel from "../components/ReviewsPanel.astro";
import { featuredGoogleReviews } from "../data/googleReviews";
export const prerender = true;
const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Miami Knife Guy Google Reviews",
  numberOfItems: featuredGoogleReviews.length,
  itemListElement: featuredGoogleReviews.map(({ name, body, rating }, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Review",
      author: { "@type": "Person", name },
      reviewBody: body,
      reviewRating: { "@type": "Rating", ratingValue: rating },
    },
  })),
};
---
<RouteShell
  title="Miami Knife Guy Reviews | Verified Google Reviews"
  description="Read all public customer reviews from Google for Miami Knife Guy knife sharpening, repair, and restoration services."
  canonicalPath="/reviews/"
  schema={schema}
>
  <ReviewsPanel />
</RouteShell>
