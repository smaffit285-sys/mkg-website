---
import RouteShell from "../../components/RouteShell.astro";
import CustomerFlowPage from "../../components/CustomerFlowPage.astro";
import QuickIntake from "../../components/QuickIntake.astro";
import ServiceLogistics from "../../components/ServiceLogistics.astro";
export const prerender = true;
---
<RouteShell
  title="Book Home Knife Sharpening Miami | MKG"
  description="Request shop-based home knife sharpening, Working Edge service, premium White Glove knife care, pickup and return, or recurring Knife Club service."
  canonicalPath="/book/home/"
  pageClass="intake-page"
>
  <CustomerFlowPage
    intake={true}
    eyebrow="Home Kitchens · Serious Cooks"
    headline="Book home knife sharpening."
    intro="Tell Sean who the knives are for, add a photo if you have one, and choose drop-off or pickup. He’ll text you to confirm the work, price, and timing."
    steps={[
      { title: "Count the knives", copy: "Include chef, utility, paring, bread, steak, and specialty knives." },
      { title: "Choose the care level", copy: "Working Edge keeps daily knives sharp. Performance and White Glove care add refinement, finish care, and presentation." },
      { title: "Note the condition", copy: "Mention chips, broken tips, serrations, premium steel, sentimental knives, or finish-sensitive blades." },
    ]}
    primaryHref="tel:+13059095773"
    primaryLabel="Call MKG"
    secondaryHref="/miami-knife-club/"
    secondaryLabel="View Knife Club"
    nextCopy="Send the short request and any photos by text. Sean reviews the knives and confirms the quote and service window with you. If you are interested in Knife Club, you can discuss it after your first service."
  >
    <QuickIntake mode="home" />
    <details class="intake-logistics"><summary>Drop-off, pickup, travel fees &amp; turnaround</summary><ServiceLogistics mode="residential" /></details>
  </CustomerFlowPage>
</RouteShell>
