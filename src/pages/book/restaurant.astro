---
import RouteShell from "../../components/RouteShell.astro";
import CustomerFlowPage from "../../components/CustomerFlowPage.astro";
export const prerender = true;
---
<RouteShell
  title="Book Restaurant Knife Sharpening Miami | MKG"
  description="Request restaurant, hotel, or commercial kitchen knife sharpening through Miami Knife Guy."
  canonicalPath="/book/restaurant/"
>
  <CustomerFlowPage
    eyebrow="Sharp After Dark"
    headline="Book restaurant edge care."
    intro="Start with the size of your knife fleet, your operating schedule, service frequency, and any steak-knife or repair needs."
    steps={[
      { title: "Describe the kitchen", copy: "Share restaurant or hotel name, location, operating hours, and the best contact." },
      { title: "Estimate the fleet", copy: "Include chef knives, prep knives, steak knives, specialty blades, and known damage." },
      { title: "Plan the cycle", copy: "MKG will discuss collection, return timing, recurring frequency, and fleet accountability." },
    ]}
    primaryHref="sms:+13059095773?body=Hi%20Miami%20Knife%20Guy%2C%20I%27d%20like%20to%20set%20up%20restaurant%20knife%20service."
    primaryLabel="Text Restaurant Request"
    secondaryHref="/sharp-after-dark/"
    secondaryLabel="View Sharp After Dark"
  />
</RouteShell>
