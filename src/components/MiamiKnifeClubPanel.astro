---
import FAQSection from "./FAQSection.astro";

interface Props {
  faq: Array<{ question: string; answer: string }>;
}

const { faq } = Astro.props;
---
<!-- ====================================================
PANEL: MIAMI KNIFE CLUB
==================================================== -->
<div id="panel-miami-knife-club" class="panel" aria-hidden="false">
<div class="panel-inner">
<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

<div>
<p class="sub-eyebrow">Home Cooks &middot; Private Chefs &middot; Serious Food People</p>
<h2 class="sub-headline-cyan text-4xl lg:text-5xl mb-6">Miami Knife Club</h2>
<p class="sub-body mb-6">Recurring edge care for serious home kitchens&mdash;scheduled before the knives start fighting back. Choose a plan that keeps sharpening on the calendar and one more chore off your mind.</p>
<p class="sub-body mb-10 text-sm" style="color:rgba(255,255,255,0.32);">Starting at $29/mo. No commitment traps. Cancel whenever you want.</p>

<div class="mb-10">
<div class="feature-item">
<div class="feature-dot-cyan"></div>
<div><div class="text-white/80 text-[21px] font-semibold mb-1 tracking-wide">Sharpening Included</div><div class="text-white/38 text-[18px] font-light leading-relaxed">Starter: 2 knives once a month or 7 knives twice a year. Pro Chef: up to 6 knives once a month or up to 20 knives twice a year.</div></div>
</div>
<div class="feature-item">
<div class="feature-dot-cyan"></div>
<div><div class="text-white/80 text-[21px] font-semibold mb-1 tracking-wide">Shop Service &amp; Pickup Options</div><div class="text-white/38 text-[18px] font-light leading-relaxed">Sharpening is performed at the MKG shop. Drop-off is available, with pickup and return arranged when requested.</div></div>
</div>
<div class="feature-item">
<div class="feature-dot-cyan"></div>
<div><div class="text-white/80 text-[21px] font-semibold mb-1 tracking-wide">Online Knife Care Course</div><div class="text-white/38 text-[18px] font-light leading-relaxed">Every member gets access to the MKG knife care curriculum &mdash; extend your edge between service visits.</div></div>
</div>
<div class="feature-item">
<div class="feature-dot-cyan"></div>
<div><div class="text-white/80 text-[21px] font-semibold mb-1 tracking-wide">Priority Turnaround</div><div class="text-white/38 text-[18px] font-light leading-relaxed">Members jump the queue. Your knives come back fast because your kitchen shouldn't wait.</div></div>
</div>
</div>

<div class="flex flex-wrap gap-4">
<a href="/book/home/" class="panel-cta-btn panel-cta-cyan">Join the Club</a>
<a href="/contact/" class="panel-cta-btn panel-cta-ghost">Ask a Question &rarr;</a>
</div>
</div>

<div class="flex flex-col gap-5">
<div class="relative overflow-hidden rounded border border-cyan-900/20 bg-black">
<img src="/images/services/neon-knives.webp" class="w-full h-[240px] object-cover opacity-60" alt="Miami Knife Club" loading="lazy" width="600" height="240">
<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
<div class="absolute bottom-0 left-0 w-full h-px" style="background:rgba(34,211,238,0.18)"></div>
</div>
<div class="space-y-2">
<div class="p-4 border border-white/6 rounded bg-white/[0.018] flex items-center justify-between">
<div><div class="text-white/78 text-[18px] font-bold uppercase tracking-wider mb-0.5">Starter</div><div class="text-white/32 text-[15px] font-light">2 knives monthly or 7 knives twice yearly &middot; Online course</div></div>
<div class="text-cyan-400 font-bold text-[21px]">$29<span class="text-white/28 font-light text-[15px]">/mo</span></div>
</div>
<div class="p-4 border border-cyan-500/22 rounded" style="background:rgba(34,211,238,0.035)">
<div class="flex items-center justify-between mb-1">
<div class="text-white/88 text-[18px] font-bold uppercase tracking-wider">Pro Chef</div>
<div class="text-cyan-400 font-bold text-[21px]">$79<span class="text-white/28 font-light text-[15px]">/mo</span></div>
</div>
<div class="text-white/32 text-[15px] font-light">Up to 6 knives monthly or 20 knives twice yearly &middot; Pickup options &middot; Priority turnaround</div>
</div>
<div class="p-4 border border-white/6 rounded bg-white/[0.018] flex items-center justify-between">
<div><div class="text-white/78 text-[18px] font-bold uppercase tracking-wider mb-0.5">Elite Kitchen</div><div class="text-white/32 text-[15px] font-light">Unlimited &middot; Fleet mgmt &middot; Staff training</div></div>
<div class="text-cyan-400 font-bold text-[21px]">Custom</div>
</div>
</div>
</div>

</div>
<FAQSection items={faq} accent="cyan" class="mt-14 pt-10 border-t border-white/5" />
</div>
</div><!-- /panel-miami-knife-club -->
