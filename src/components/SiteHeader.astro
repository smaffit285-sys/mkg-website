---
const currentPath = Astro.url.pathname;
const servicePaths = new Set([
    "/services/",
    "/knife-sharpening-miami/",
    "/restaurant-knife-sharpening-miami/",
    "/japanese-knife-sharpening-miami/",
    "/knife-repair-restoration-miami/",
    "/steak-knife-sharpening-miami-restaurants/",
]);
const isCurrent = (path: string) => path === "/services/" ? servicePaths.has(currentPath) : currentPath === path;
---
<header class="mkg-header fixed top-0 left-0 w-full z-50 bg-[#020202]/96 backdrop-blur-md border-b border-white/5">
    <div class="mkg-header-inner h-20 flex items-center justify-between gap-8">

        <a id="logo-home-btn" href="/" class="flex items-center gap-4 shrink-0 cursor-pointer">
            <div class="w-12 h-12 rounded-full border border-gray-700/40 bg-black overflow-hidden flex items-center justify-center">
                <img src="/images/brand/mkg-logo.jpg" alt="MKG" class="w-full h-full object-contain mix-blend-lighten opacity-90" width="48" height="48">
            </div>
            <span class="text-lg font-medium tracking-wider whitespace-nowrap">Miami Knife Guy</span>
        </a>

        <nav class="hidden lg:flex flex-1 justify-center gap-8 xl:gap-10 text-[10px] tracking-[0.25em] uppercase text-gray-400 font-semibold whitespace-nowrap">
            <a href="/sharp-after-dark/" id="nav-sad" class:list={["nav-neon-link", { "nav-active": isCurrent("/sharp-after-dark/") }]} aria-current={isCurrent("/sharp-after-dark/") ? "page" : undefined}>Sharp After Dark</a>
            <a href="/miami-knife-club/" id="nav-mkc" class:list={["nav-neon-link", { "nav-active": isCurrent("/miami-knife-club/") }]} aria-current={isCurrent("/miami-knife-club/") ? "page" : undefined}>Knife Club</a>
            <a href="/proof/" id="nav-proof" class:list={["nav-neon-link", { "nav-active": isCurrent("/proof/") }]} aria-current={isCurrent("/proof/") ? "page" : undefined}>Proof</a>
            <a href="/reviews/" id="nav-reviews" class:list={["nav-neon-link", { "nav-active": isCurrent("/reviews/") }]} aria-current={isCurrent("/reviews/") ? "page" : undefined}>Reviews</a>
            <a href="/services/" id="nav-services" class:list={["nav-neon-link", { "nav-active": isCurrent("/services/") }]} aria-current={isCurrent("/services/") ? "page" : undefined}>Services</a>
            <a href="/about/" id="nav-story" class:list={["nav-neon-link", { "nav-active": isCurrent("/about/") }]} aria-current={isCurrent("/about/") ? "page" : undefined}>Our Story</a>
        </nav>

        <div class="flex items-center gap-6 shrink-0">
            <a href="tel:+13059095773" class="mkg-header-phone hidden xl:inline text-sm font-light tracking-widest text-gray-300">(305) 909-5773</a>
            <a href="/book/" aria-current={currentPath.startsWith("/book/") ? "page" : undefined} class="mkg-header-cta neon-btn-cyan border-2 rounded-md px-6 py-2.5 text-[11px] font-bold tracking-[0.2em] uppercase transition-all duration-300 whitespace-nowrap hidden sm:inline-flex">
                Book Service
            </a>
            <button id="mkg-hamburger" class="mkg-mobile-menu-button flex lg:hidden" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mkg-mobile-menu">
                <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <line x1="2" y1="5" x2="16" y2="5"/>
                    <line x1="2" y1="9" x2="16" y2="9"/>
                    <line x1="2" y1="13" x2="16" y2="13"/>
                </svg>
            </button>
        </div>

    </div>

    <div class="mkg-mobile-cta-row">
        <a href="/book/" class="neon-btn-cyan border-2 rounded-md text-[11px] font-bold tracking-[0.2em] uppercase transition-all duration-300">
            Book Service
        </a>
    </div>

    <nav id="mkg-mobile-menu" class="mkg-mobile-menu" aria-label="Mobile navigation">
        <a href="/sharp-after-dark/" class="mkg-mobile-menu-link" aria-current={isCurrent("/sharp-after-dark/") ? "page" : undefined}>Sharp After Dark</a>
        <a href="/miami-knife-club/" class="mkg-mobile-menu-link" aria-current={isCurrent("/miami-knife-club/") ? "page" : undefined}>Knife Club</a>
        <a href="/proof/" class="mkg-mobile-menu-link" aria-current={isCurrent("/proof/") ? "page" : undefined}>Proof</a>
        <a href="/reviews/" class="mkg-mobile-menu-link" aria-current={isCurrent("/reviews/") ? "page" : undefined}>Reviews</a>
        <a href="/services/" class="mkg-mobile-menu-link" aria-current={isCurrent("/services/") ? "page" : undefined}>Services</a>
        <a href="/about/" class="mkg-mobile-menu-link" aria-current={isCurrent("/about/") ? "page" : undefined}>Our Story</a>
    </nav>
</header>
