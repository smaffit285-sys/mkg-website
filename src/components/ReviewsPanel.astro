---
import { GOOGLE_REVIEW_COUNT, GOOGLE_REVIEW_URL } from "../config/site";
import { googleReviews } from "../data/googleReviews";
---
<!-- ====================================================
PANEL: REVIEWS
==================================================== -->
<div id="panel-reviews" class="panel" aria-hidden="true">
<div class="panel-inner">

<div class="flex flex-col sm:flex-row sm:items-end gap-4 mb-10">
<div>
<p class="sub-eyebrow">Verified Google Reviews</p>
<h2 class="sub-headline-cyan text-3xl lg:text-4xl mb-0">What Clients Say</h2>
</div>
<div class="sm:ml-auto flex items-center gap-3 pb-1">
<span class="text-4xl font-bold text-white/88">5.0</span>
<div>
<div class="text-cyan-400 text-sm tracking-widest">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
<div class="text-[9px] uppercase tracking-widest text-white/28 font-bold">Google &middot; {GOOGLE_REVIEW_COUNT} Reviews</div>
</div>
</div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">
{googleReviews.map((review, index) => (
<article class="review-card">
<div class="star-row" aria-label={`${review.rating} out of 5 stars`}>&#9733;&#9733;&#9733;&#9733;&#9733;</div>
<p class="review-quote whitespace-pre-line" style="font-size:1.05rem;">&ldquo;{review.body}&rdquo;</p>
<div class="flex items-center gap-3">
<div class:list={[
  "w-8 h-8 rounded-full border flex items-center justify-center text-[11px] font-bold",
  index % 2 === 0
    ? "bg-cyan-900/40 border-cyan-500/20 text-cyan-400"
    : "bg-pink-900/40 border-pink-500/20 text-pink-400",
]}>{review.name.charAt(0).toUpperCase()}</div>
<div>
<div class="review-source" style="font-size:13.5px;">{review.name}</div>
<div class="text-[9px] text-white/20 font-light mt-0.5">Google</div>
</div>
</div>
</article>
))}
</div>

<!-- Legacy reviews — Perfect Edge -->
<div class="mb-10">
<p class="text-[9px] uppercase tracking-widest text-white/22 font-bold mb-5">Legacy Reviews &middot; Perfect Edge</p>
<p class="text-white/38 text-sm font-light leading-relaxed mb-5">Selected Bay Area hospitality clients served during Sean&rsquo;s years with Perfect Edge. These legacy reviews reflect that earlier work, not current Miami Knife Guy client relationships.</p>
<div class="grid grid-cols-1 md:grid-cols-3 gap-5">

<div class="review-card" style="border-color:rgba(251,191,36,0.12);">
<div class="star-row" style="color:rgba(251,191,36,0.80);">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
<p class="review-quote" style="font-size:1.05rem;">&ldquo;Perfect Edge sharpened our entire kitchen fleet. The results were exceptional &mdash; every blade came back with a working edge that held up through service.&rdquo;</p>
<div class="flex items-center gap-3">
<div class="w-8 h-8 rounded-full bg-amber-900/40 border border-amber-500/20 flex items-center justify-center text-[11px] font-bold text-amber-400">L</div>
<div>
<div class="review-source" style="font-size:13.5px;">The French Laundry</div>
<div class="text-[9px] text-white/20 font-light mt-0.5">Yelp via Perfect Edge</div>
</div>
</div>
</div>

<div class="review-card" style="border-color:rgba(251,191,36,0.12);">
<div class="star-row" style="color:rgba(251,191,36,0.80);">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
<p class="review-quote" style="font-size:1.05rem;">&ldquo;We've trusted Sean with our knives for years. Precise, reliable, and he understands the demands of a high-volume professional kitchen.&rdquo;</p>
<div class="flex items-center gap-3">
<div class="w-8 h-8 rounded-full bg-amber-900/40 border border-amber-500/20 flex items-center justify-center text-[11px] font-bold text-amber-400">R</div>
<div>
<div class="review-source" style="font-size:13.5px;">Ritz-Carlton Kitchen Team</div>
<div class="text-[9px] text-white/20 font-light mt-0.5">Yelp via Perfect Edge</div>
</div>
</div>
</div>

<div class="review-card" style="border-color:rgba(251,191,36,0.12);">
<div class="star-row" style="color:rgba(251,191,36,0.80);">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
<p class="review-quote" style="font-size:1.05rem;">&ldquo;Outstanding work on our Japanese single-bevel knives. Sean takes time to understand each blade before touching it. That's rare in this business.&rdquo;</p>
<div class="flex items-center gap-3">
<div class="w-8 h-8 rounded-full bg-amber-900/40 border border-amber-500/20 flex items-center justify-center text-[11px] font-bold text-amber-400">Z</div>
<div>
<div class="review-source" style="font-size:13.5px;">Zuni Caf&eacute; Staff</div>
<div class="text-[9px] text-white/20 font-light mt-0.5">Yelp via Perfect Edge</div>
</div>
</div>
</div>

</div>
</div>

<div class="p-6 border border-white/6 rounded bg-white/[0.02] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5 mb-5">
<div>
<p class="text-white/75 text-sm font-semibold mb-1">Happy with your edge?</p>
<p class="text-white/42 text-xs font-light leading-relaxed max-w-md">Leave a public Google review, or send private feedback directly to MKG.</p>
</div>
<div class="flex flex-wrap gap-3 shrink-0">
<a href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener noreferrer" class="mkg-header-cta neon-btn-cyan border-2 rounded-md px-6 py-2.5 text-[11px] font-bold tracking-[0.2em] uppercase transition-all duration-300">Leave a Google Review</a>
<a href="/review/" class="panel-cta-btn panel-cta-ghost">Private Feedback</a>
</div>
</div>

<p class="text-white/24 text-[9px] uppercase tracking-widest font-semibold">Google reviews shown here were verified against the public Miami Knife Guy listing.</p>

</div>
</div><!-- /panel-reviews -->
