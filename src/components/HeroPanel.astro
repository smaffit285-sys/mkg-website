<!-- SECTION 16: BRING BACK THE GLIDE - final CTA signage moment -->
<section class="mkg-glide-cta">

<!-- Decorative skyline reflection -->
<div class="mkg-glide-reflection" aria-hidden="true"></div>

<div class="relative z-10 max-w-3xl mx-auto text-center">
<!-- The signage -->
<p class="text-[11px] uppercase tracking-[0.3em] text-white/22 font-bold mb-6" style="font-family:'Montserrat',sans-serif;">Miami Knife Guy &middot; North Miami Beach</p>
<div class="mb-8">
<p class="leading-none mb-1" style="font-family:'Dosis','Montserrat',sans-serif; font-weight:300; font-size:clamp(1.5rem,4vw,2.2rem); letter-spacing:0.06em; text-transform:uppercase; color:transparent; -webkit-text-stroke:1px rgba(255,255,255,0.7); text-shadow:0 0 8px rgba(255,255,255,0.3), 0 0 20px rgba(255,255,255,0.12);">Bring back the</p>
<p class="leading-none" style="font-family:'Playfair Display',serif; font-weight:900; font-style:italic; font-size:clamp(3rem,10vw,6rem); line-height:0.9; color:#ec4899; text-shadow:0 0 6px #ec4899, 0 0 18px rgba(236,72,153,0.7), 0 0 40px rgba(236,72,153,0.4), 0 0 80px rgba(236,72,153,0.2); letter-spacing:-0.01em;">Glide.</p>
</div>
<!-- Reflection line -->
<div class="w-px h-8 mx-auto mb-8" style="background:linear-gradient(to bottom, rgba(236,72,153,0.4), transparent);"></div>
<!-- CTAs -->
<div class="flex flex-wrap justify-center gap-4">
<a href="https://mkggrowthengine.vercel.app/register" class="panel-cta-btn panel-cta-pink" style="font-size:10px; letter-spacing:0.22em;">Get Your Edge Back</a>
<a href="https://mkggrowthengine.vercel.app/register" class="panel-cta-btn panel-cta-ghost" style="font-size:10px; letter-spacing:0.22em;">Schedule Service</a>
