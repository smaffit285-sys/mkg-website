---
import SiteFooter from "./SiteFooter.astro";
---
<!-- ====================================================
PANEL: HOME
==================================================== -->
<div id="panel-home" class="panel active mkg-home-panel" aria-hidden="false">

<!-- HERO -->
<main class="mkg-home-hero w-full relative overflow-hidden bg-[#050505]">
<div class="mkg-hero-bg-stage absolute inset-0 z-0 pointer-events-none">
<img src="/images/backgrounds/miami-skyline.jpg"
class="mkg-hero-skyline absolute inset-0 w-full h-full object-cover opacity-80 z-10"
alt="Miami Skyline"
loading="lazy"
width="1600"
height="900">

<div class="absolute top-[7%] left-1/2 -translate-x-1/2 w-[620px] h-[620px] rounded-full z-0 bg-gradient-to-b from-pink-500 via-purple-600 to-transparent opacity-18 blur-3xl"></div>
<div class="absolute inset-0 bg-gradient-to-b from-[#050505]/28 via-transparent to-[#050505] z-20"></div>
</div>

<div class="mkg-hero-content">
<div class="mkg-hero-copy">
<div class="relative">
<!-- UNLIT TUBE LAYER -->
<h1 class="hero-neon-title unlit-tube-layer" aria-hidden="true">
<span class="hero-line hero-line-one neon-tube-cyan whitespace-nowrap pb-1">A <span class="hero-word hero-word-dull">dull knife</span> doesn't</span>
<span class="hero-line hero-line-two neon-tube-cyan whitespace-nowrap pb-1">just <span class="hero-word hero-word-slow">slow</span> the <span class="hero-word hero-word-kitchen">kitchen</span>.</span>
<span class="hero-line hero-line-three neon-tube-pink whitespace-nowrap">It breaks the spell.</span>
</h1>

<!-- LIT IGNITION LAYER -->
<h1 class="hero-neon-title relative" style="z-index:1;">
<span class="hero-line hero-line-one neon-tube-cyan whitespace-nowrap pb-1">A <span class="hero-word hero-word-dull">dull knife</span> doesn't</span>
<span class="hero-line hero-line-two neon-tube-cyan whitespace-nowrap pb-1">just <span class="hero-word hero-word-slow">slow</span> the <span class="hero-word hero-word-kitchen">kitchen</span>.</span>
<span class="hero-line hero-line-three neon-tube-pink whitespace-nowrap">It breaks the spell.</span>
</h1>
</div>

<div class="mkg-hero-intro">
<p class="text-gray-100 font-normal mb-5 drop-shadow-[0_3px_12px_rgba(0,0,0,0.95)]">
<span class="mkg-hero-intro-lead">
Edge care that keeps the <span class="mkg-hero-intro-magic">magic</span> intact.
</span>
<span class="mkg-hero-intro-support">
Precision sharpening, repair, and restoration for Miami restaurants, chefs, and serious home cooks.
</span>
</p>

<div class="mkg-hero-cta-row">
<a href="sms:+13059095773?body=SHARP"
class="panel-cta-btn panel-cta-pink"
style="font-size:10px; letter-spacing:0.22em;">
Text SHARP
</a>

<a href="#services"
onclick="navigateTo('services'); return false;"
class="panel-cta-btn panel-cta-ghost"
style="font-size:10px; letter-spacing:0.22em;">
View Services
</a>
</div>
</div>
</div>
</div>
</main>

<!-- SERVICE GATEWAY CARDS -->
<section class="mkg-service-gateway-section w-full px-12 lg:px-24 pt-0 pb-4 relative z-20 overflow-hidden">
<div class="mkg-service-grid-floor" aria-hidden="true"></div>
<div class="max-w-7xl mx-auto w-full grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-24 relative z-10">
<!-- Sharp After Dark -->
<div onclick="navigateTo('sharp-after-dark')" class="group cursor-pointer relative flex flex-col mt-0">
<div class="hardware-gateway after-dark-grid h-[260px] sm:h-[280px] lg:h-[300px] w-full flex items-center justify-center">
<div class="service-card-water-scrim" aria-hidden="true"></div>
<img
src="/images/services/gemini-table.png"
class="service-card-bg service-card-bg--after-dark absolute inset-0 w-full h-full object-cover opacity-0 grayscale transition-all duration-1000 group-hover:opacity-60 group-hover:grayscale-0 z-10 rounded-lg"
alt="Sharp After Dark commercial knife sharpening"
loading="lazy"
>
<div class="gateway-vignette"></div>
<div class="service-card-logo-stage">
<img
src="/images/brand/sharp-after-dark-transparent.png"
alt="Sharp After Dark"
class="service-card-logo service-card-logo--afterdark"
loading="lazy"
>
</div>
<div class="gateway-contact-cap gateway-contact-cap--after-dark" aria-hidden="true"></div>
<div class="gateway-contact-pin gateway-contact-pin--after-a" aria-hidden="true"></div>
<div class="gateway-contact-pin gateway-contact-pin--after-b" aria-hidden="true"></div>
</div>
<div class="service-transformer-stack w-full flex flex-col items-center">
<svg class="service-transformer-wires service-transformer-wires--after-dark" viewBox="0 0 100 100" preserveAspectRatio="none">
<path class="hv-wire-bg" d="M72 28 C72 44, 44 54, 48 57"></path>
<path class="hv-wire" d="M72 28 C72 44, 44 54, 48 57"></path>
<path class="hv-wire-bg" d="M80 28 C80 44, 48 54, 52 57"></path>
<path class="hv-wire" d="M80 28 C80 44, 48 54, 52 57"></path>
</svg>
<div class="transformer-chassis flex flex-col justify-between">
<div class="transformer-terminal-row" aria-hidden="true">
<span class="transformer-terminal transformer-terminal--a"></span>
<span class="transformer-terminal transformer-terminal--b"></span>
</div>
<div class="absolute -right-[6px] top-[28px] w-[6px] h-[10px] bg-[#121218] border border-[#2a2a36] rounded-r z-30 flex items-center justify-center">
<div class="w-[2px] h-[4px] bg-white/10"></div>
</div>
<div class="absolute right-[70px] -top-[6px] w-[10px] h-[6px] bg-[#121218] border border-[#2a2a36] rounded-t z-30 flex items-center justify-center">
<div class="w-[4px] h-[2px] bg-white/10"></div>
</div>
<div class="flex justify-between items-center mb-1.5">
<span class="grounding-node"></span>
<span class="grounding-node"></span>
</div>
<p class="spec-text text-gray-400 text-xs font-light leading-relaxed text-center m-0 uppercase tracking-widest relative z-20 transition-colors duration-700">
After service, you rest. Before prep, they're sharp. Zero-downtime edge care for working kitchens.
</p>
<div class="flex justify-between items-center mt-1.5">
<span class="grounding-node"></span>
<span class="grounding-node"></span>
</div>
</div>
</div>
</div>
<!-- Miami Knife Club -->
<div onclick="navigateTo('miami-knife-club')" class="group cursor-pointer relative flex flex-col mt-0">
<div class="hardware-gateway club-grid h-[260px] sm:h-[280px] lg:h-[300px] w-full flex items-center justify-center">
<div class="service-card-water-scrim" aria-hidden="true"></div>
<img
src="/images/services/neon-knives.png"
class="service-card-bg service-card-bg--club absolute inset-0 w-full h-full object-cover opacity-0 grayscale transition-all duration-1000 group-hover:opacity-85 group-hover:grayscale-0 z-10 rounded-lg"
alt="Premium knives with neon lighting"
loading="lazy"
>
<div class="gateway-vignette"></div>
<div class="service-card-logo-stage">
<img
src="/images/brand/miami-knife-club-transparent.png"
alt="Miami Knife Club"
class="service-card-logo service-card-logo--knifeclub"
loading="lazy"
>
</div>
<div class="gateway-contact-cap gateway-contact-cap--club" aria-hidden="true"></div>
<div class="gateway-contact-pin gateway-contact-pin--club-a" aria-hidden="true"></div>
<div class="gateway-contact-pin gateway-contact-pin--club-b" aria-hidden="true"></div>
</div>
<div class="service-transformer-stack w-full flex flex-col items-center">
<svg class="service-transformer-wires service-transformer-wires--club" viewBox="0 0 100 100" preserveAspectRatio="none">
<path class="hv-wire-bg" d="M20 28 C20 44, 52 54, 48 57"></path>
<path class="hv-wire" d="M20 28 C20 44, 52 54, 48 57"></path>
<path class="hv-wire-bg" d="M28 28 C28 44, 56 54, 52 57"></path>
<path class="hv-wire" d="M28 28 C28 44, 56 54, 52 57"></path>
</svg>
<div class="transformer-chassis flex flex-col justify-between">
<div class="transformer-terminal-row" aria-hidden="true">
<span class="transformer-terminal transformer-terminal--a"></span>
<span class="transformer-terminal transformer-terminal--b"></span>
</div>
<div class="absolute -left-[6px] top-[28px] w-[6px] h-[10px] bg-[#121218] border border-[#2a2a36] rounded-l z-30 flex items-center justify-center">
<div class="w-[2px] h-[4px] bg-white/10"></div>
</div>
<div class="absolute left-[70px] -top-[6px] w-[10px] h-[6px] bg-[#121218] border border-[#2a2a36] rounded-t z-30 flex items-center justify-center">
<div class="w-[4px] h-[2px] bg-white/10"></div>
</div>
<div class="flex justify-between items-center mb-1.5">
<span class="grounding-node"></span>
<span class="grounding-node"></span>
</div>
<p class="spec-text text-gray-400 text-xs font-light leading-relaxed text-center m-0 uppercase tracking-widest relative z-20 transition-colors duration-700">
Recurring edge care for homes that cook seriously.
</p>
<div class="flex justify-between items-center mt-1.5">
<span class="grounding-node"></span>
<span class="grounding-node"></span>
</div>
</div>
</div>
</div>
</div>
</section>
