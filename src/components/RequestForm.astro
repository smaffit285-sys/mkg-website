---
import "../styles/intake.css";
type Option = { value: string; label: string };
type Field = {
  name: string; label: string;
  type?: "text" | "tel" | "email" | "number" | "url" | "select" | "textarea" | "file" | "hidden";
  required?: boolean; placeholder?: string; rows?: number; options?: Option[];
  fullWidth?: boolean; accept?: string; multiple?: boolean; value?: string;
  private?: boolean; help?: string; autocomplete?: string; min?: number; step?: number;
};
interface Props {
  id: string; title: string; description: string; source: string; serviceType: string;
  submitLabel: string; fields: Field[]; photoHandoff?: boolean;
  clubTitle?: string; clubSource?: string; clubServiceType?: string; clubSubmitLabel?: string;
}
const { id, title, description, source, serviceType, submitLabel, fields,
  photoHandoff = false, clubTitle, clubSource, clubServiceType, clubSubmitLabel } = Astro.props;
const autocomplete = { name: "name", phone: "tel", email: "email", business: "organization" };
---
<section class="request-section" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  <p class="request-description">{description}</p>
  <p class="request-required">Fields marked * are required. Everything else helps us prepare.</p>
  <form id={id} class="request-form" data-mkg-request-form data-form-title={title}
    data-photo-handoff={String(photoHandoff)} data-club-title={clubTitle}
    data-club-source={clubSource} data-club-service-type={clubServiceType} data-club-submit-label={clubSubmitLabel}>
    <input type="hidden" name="source" value={source} data-private />
    <input type="hidden" name="serviceType" value={serviceType} data-private />
    {fields.map((field) => {
      const type = field.type ?? "text";
      const helpId = `${id}-${field.name}-help`;
      if (type === "hidden") return <input type="hidden" name={field.name} value={field.value ?? ""} data-label={field.label} data-private={field.private || undefined} />;
      return (
        <label class:list={["request-field", { "request-field-wide": field.fullWidth }]}>
          <span class="request-label">{field.label}{field.required ? <span class="request-star" aria-hidden="true"> *</span> : <span class="request-optional"> (optional)</span>}</span>
          {type === "select" ? (
            <select name={field.name} required={field.required} data-label={field.label} aria-describedby={field.help ? helpId : undefined}>
              <option value="">Choose one</option>
              {field.options?.map((option) => <option value={option.value} selected={field.value === option.value}>{option.label}</option>)}
            </select>
          ) : type === "textarea" ? (
            <textarea name={field.name} required={field.required} placeholder={field.placeholder} data-label={field.label} rows={field.rows ?? 4} aria-describedby={field.help ? helpId : undefined}></textarea>
          ) : type === "file" ? (
            <input type="file" name={field.name} required={field.required} accept={field.accept} multiple={field.multiple} data-label={field.label} aria-describedby={field.help ? helpId : undefined} />
          ) : (
            <input type={type} name={field.name} required={field.required} placeholder={field.placeholder}
              value={field.value} data-label={field.label} min={field.min} step={field.step}
              autocomplete={field.autocomplete ?? autocomplete[field.name as keyof typeof autocomplete]}
              aria-describedby={field.help ? helpId : undefined} />
          )}
          {field.help && <span class="request-help" id={helpId}>{field.help}</span>}
        </label>
      );
    })}
    <div class="request-field-wide request-action-area">
      <p class="request-handoff-note">Review your message, then send it to Sean. Nothing is sent by this form automatically.</p>
      <div class="request-actions">
        <button type="submit" data-prepare-request class="panel-cta-btn panel-cta-pink">{submitLabel}</button>
        <a href="tel:+13059095773" class="request-phone">Or call (305) 909-5773</a>
      </div>
      <p class="request-privacy">Your details and photos stay on this page until you choose to copy or share them. <a href="/privacy/">Privacy</a></p>
    </div>
    <section class="request-field-wide request-preview" data-request-preview hidden aria-labelledby={`${id}-preview-title`}>
      <h3 id={`${id}-preview-title`}>Your message is ready to send</h3>
      <p>Send to <strong>Miami Knife Guy · (305) 909-5773</strong>.</p>
      <label class="request-field"><span class="request-label">Request summary</span><textarea data-request-message readonly rows="8"></textarea></label>
      <p class="request-help" data-file-summary></p>
      <div class="request-actions">
        <a data-open-message class="panel-cta-btn panel-cta-cyan">Open text message</a>
        <button type="button" data-share-photos class="panel-cta-btn panel-cta-cyan" hidden>Share message &amp; photos</button>
        <button type="button" data-copy-request class="panel-cta-btn panel-cta-ghost">Copy request</button>
      </div>
      <p class="request-help">No messaging app on this device? Copy the request to send from your phone, or call Sean. For service requests, timing is confirmed in Sean’s reply.</p>
    </section>
    <p class="request-field-wide request-status" data-form-status role="status" aria-live="polite"></p>
    <noscript><p class="request-field-wide request-help">To request service without this form, <a href="tel:+13059095773">call</a> or <a href="sms:+13059095773">text (305) 909-5773</a>. Include your name, location, and knife details.</p></noscript>
  </form>
</section>
<script>
  import { initRequestForms } from "../scripts/request-form.js";
  initRequestForms(document);
</script>
